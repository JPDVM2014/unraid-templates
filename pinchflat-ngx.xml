<?xml version="1.0"?>
<Container version="2">
  <Name>pinchflat-ngx</Name>
  <Repository>ghcr.io/thebadfella/pinchflat-ngx:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/122788-support-jpdvm2014-templates</Support>
  <Project>https://github.com/TheBadFella/Pinchflat-NGX</Project>
  <ReadMe>This is a basic minimal setup. For advanced configuration, check the project's github: https://github.com/TheBadFella/Pinchflat-NGX</ReadMe>
  <Overview>An enhanced, self-hosted YouTube media manager built on Pinchflat with Material 3 AMOLED UI, PostgreSQL support, OIDC SSO, and disk staging.</Overview>
  <Category>MediaServer:Video</Category>
  <WebUI>http://[IP]:[PORT:8945]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/TheBadFella/Pinchflat-NGX/refs/heads/master/docs/assets/brand/icon.png</Icon>
  <ExtraParams>--user 99:100</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1792307751</DateInstalled>
  <DonateText>If you find this template useful, I’d love a coffee!</DonateText>
  <DonateLink>https://bmc.link/JPDVM2014</DonateLink>
  <Requires/>
  <Config Name="WebUI" Target="8945" Default="8945" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">8945</Config>  	
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/pinchflat-ngx/config" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pinchflat-ngx/config</Config>
  <Config Name="Downloads" Target="/downloads" Default="" Mode="rw" Description="Path where media is downloaded" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Timezone" Target="TZ" Default="UTC" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">UTC</Config>
  <TailscaleStateDir/>
</Container>