<?xml version="1.0"?>
<Container version="2">
  <Name>sonorium</Name>
  <Repository>ghcr.io/synssins/sonorium:latest</Repository>
  <Registry/>
  <Network>host</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/122788-support-jpdvm2014-templates</Support>
  <Project>https://github.com/synssins/sonorium</Project>
  <ReadMe/>
  <Overview>Sonorium is an ambient soundscape mixer for Home Assistant that lets you craft immersive audio environments throughout your home. Stream richly layered sounds&#x2014;from distant thunder and rainfall to forest wildlife and flowing water&#x2014;to any media player in your space, creating the perfect atmosphere for focus, relaxation, or sleep.</Overview>
  <Category>Other:</Category>
  <WebUI>http://[IP]:[PORT:8008]/</WebUI>
  <TemplateURL/>
  <Icon>https://github.com/synssins/sonorium/raw/refs/heads/main/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1791592680</DateInstalled>
  <DonateText>If you find this template useful, I’d love a coffee!</DonateText>
  <DonateLink>https://bmc.link/JPDVM2014</DonateLink>
  <Requires>Needs to be in host mode for speaker discovery. Uses port 8008.</Requires>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/sonorium/config" Mode="rw" Description="settings and channels" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/sonorium/config</Config>
  <Config Name="Host Path 2" Target="/media/sonorium" Default="/mnt/user/appdata/sonorium/media" Mode="rw" Description="themes and audio" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/sonorium/media</Config>
  <Config Name="Timezone" Target="TZ" Default="Etc/UTC" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">Etc/UTC</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <TailscaleStateDir/>
</Container>