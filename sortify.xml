<?xml version="1.0"?>
<Container version="2">
  <Name>sortify</Name>
  <Repository>ghcr.io/lklynet/sortify:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/122788-support-jpdvm2014-templates</Support>
  <Project>https://github.com/lklynet/sortify</Project>
  <ReadMe/>
  <Overview>Sortify is a self-hosted playlist assistant for Navidrome. It scans your library, stores metadata locally, and generates recommended playlists from the web UI. It does NOT touch your files metadata and instead stores it in a local SQLite database, keeping your files safe and untouched.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:3001]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/JPDVM2014/icons/refs/heads/main/sortify_logo.png</Icon>
  <ExtraParams>--user 99:100</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1780103142</DateInstalled>
  <DonateText>If you find this template useful, I’d love a coffee!</DonateText>
  <DonateLink>https://bmc.link/JPDVM2014</DonateLink>
  <Requires/>
  <Config Name="WebUI" Target="3001" Default="" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">3001</Config>
  <Config Name="Appdata" Target="/data" Default="" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/sortify</Config>
  <TailscaleStateDir/>
</Container>
