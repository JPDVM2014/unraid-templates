<?xml version="1.0"?>
<Container version="2">
  <Name>kin-crm</Name>
  <Repository>ghcr.io/jpdvm2014/kin-crm-docker</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/122788-support-jpdvm2014-templates</Support>
  <Project>https://github.com/ock666/Kin-CRM</Project>
  <ReadMe>https://github.com/ock666/Kin-CRM</ReadMe>
  <Overview>Kin is a self-hosted relationship manager built by and for neurodivergent brains &#x2014; designed to help with AuDHD (Autism + ADHD), Rejection Sensitive Dysphoria (RSD), social anxiety, and overwhelm.&#13;
&#13;
It handles the remembering, the nudging, and the structure of staying in touch &#x2014; so you can focus on the people, not the pressure.&#13;
&#13;
Note: I am not the creator of kin-CRM, I just built an image to be able to easily install on Unraid and thought I would share it.</Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/JPDVM2014/kin-crm-docker/refs/heads/main/kin-crm-icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1786934465</DateInstalled>
  <DonateText>If you find this template useful, I’d love a coffee!</DonateText>
  <DonateLink>https://bmc.link/JPDVM2014</DonateLink>
  <Requires/>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/kin-crm" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/kin-crm</Config>
  <Config Name="WebUI" Target="8000" Default="8000" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">8000</Config>
  <Config Name="Timezone" Target="TZ" Default="America/New_York" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">America/New_York</Config>
  <Config Name="DATA_DIR" Target="DATA_DIR" Default="/data" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">/data</Config>
  <Config Name="DISABLE_SCHEDULER" Target="DISABLE_SCHEDULER" Default="0|1" Mode="" Description="Set to 1 for testing" Type="Variable" Display="always" Required="true" Mask="false">0</Config>
  <Config Name="ALLOWED_HOSTS" Target="ALLOWED_HOSTS" Default="localhost,127.0.0.1" Mode="" Description="Comma-separated hostnames this server accepts. Set to * or your domain in production." Type="Variable" Display="always" Required="true" Mask="false">*</Config>
  <Config Name="HTTPS_ONLY" Target="HTTPS_ONLY" Default="0|1" Mode="" Description="Set to 1 to restrict session cookies to HTTPS only (requires a TLS-terminating reverse proxy)." Type="Variable" Display="always" Required="true" Mask="false">0</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="" Type="Variable" Display="advanced-hide" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="" Type="Variable" Display="advanced-hide" Required="true" Mask="false">100</Config>
  <TailscaleStateDir/>
